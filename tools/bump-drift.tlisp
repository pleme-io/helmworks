;; bump-drift.tlisp — catch a chart edited WITHOUT its version bumped, at the
;; commit that creates the problem.
;;
;; ── WHY ─────────────────────────────────────────────────────────────────────
;; auto-release is 404-idempotent: a chart whose Chart.yaml version is already
;; in the registry is SKIPPED. So a template edit committed after that version
;; published never reaches any cluster, and NOTHING GOES RED — `git push`
;; succeeds, auto-release logs "Released 0 chart(s); skipped N
;; already-published" and exits 0, and `git log` shows the work done. The only
;; place the truth exists is the published tarball.
;;
;; Measured 2026-08-01: FOUR charts were in that state simultaneously
;; (lareira-tatara-ephemeral 0.3.0, pleme-cnpg 0.1.0, pleme-lareira-canary
;; 0.1.0, pleme-saber 0.1.0), each confirmed BOTH ways — templates newer than
;; Chart.yaml in git, AND that exact version resolving in the registry. They
;; were fixed by bumping; this exists so the fifth never has to be found by
;; hand.
;;
;; ── WHAT IT CHECKS ──────────────────────────────────────────────────────────
;; For the commit range of this push: any chart with a changed file that is NOT
;; its own Chart.yaml must ALSO have a changed Chart.yaml. That is the precise
;; form — it fires exactly when the stranding is created, and cannot
;; false-positive on a chart that has simply never published (the failure mode
;; of the cheaper "templates newer than Chart.yaml" heuristic, which flags a
;; brand-new chart that will publish fine on its first release).
;;
;; ── WHAT IT DELIBERATELY DOES NOT DO ────────────────────────────────────────
;; It does not bump. helmworks has NO auto-bump by deliberate decision (a chart
;; monorepo has no single version; bumping in its own commit is the act that
;; ships it), and a detector that silently edited the tree would take that
;; decision away from the author.
;;
;; It does not query the registry. A network call would make the gate flaky and
;; is not needed: at the moment of the edit, "version unchanged" is sufficient —
;; if the version was already published the chart is stranded, and if it was not
;; the bump is still the correct habit.
;;
;; It is REPORT-ONLY unless FAIL_ON_DRIFT=true, and it is wired as a job that
;; does NOT gate release: a drifted chart must not block the publication of the
;; other 148. Loud, not blocking.

(define base (env-get "BASE_SHA" ""))

(define head (env-get "HEAD_SHA" ""))

(define fail-on (env-get "FAIL_ON_DRIFT" "false"))

(define
  (changed-files)
  (let
    ((r (exec-capture "git" "diff" "--name-only" (string-append base ".." head))))
    (if (= (status-of r) 0)
      (filter (lambda (l) (not (equal? l ""))) (string-split (string-trim (stdout-of r)) "\n"))
      (list))))

;; "charts/<name>/..." -> "<name>", anything else -> ""
(define
  (chart-of path)
  (let ((parts (string-split path "/")))
    (if (and (>= (length parts) 3) (equal? (car parts) "charts"))
      (car (cdr parts))
      "")))

(define (chart-yaml-of name) (string-append "charts/" name "/Chart.yaml"))

;; `all` is the COMPLETE changed-file list and never shrinks; `files` is the
;; cursor. Keeping them apart is load-bearing, and conflating them was a real
;; false-positive bug (fixed 2026-08-01).
;;
;; The membership test used to read `files`, which the recursion had already
;; consumed down to the tail. `git diff --name-only` emits sorted paths, and
;; `charts/<c>/Chart.yaml` sorts BEFORE every sibling ('C' 0x43 < lowercase),
;; so by the time any other file in the same chart was examined, its Chart.yaml
;; had already been cdr'd away and `list-contains?` answered #f. The gate then
;; reported "edited with no Chart.yaml version change" about a commit that
;; changed the version in that very range.
;;
;; Measured: helmworks cc2663f, range 8557c85..cc2663f, changed files
;; [charts/lareira-clickhouse/Chart.yaml, charts/lareira-clickhouse/values.yaml],
;; version 0.2.7 -> 0.2.8 — red anyway. That shape (Chart.yaml plus at least
;; one sibling) is what a normal chart edit looks like, so the gate was crying
;; wolf on nearly every real bump while still passing the one case it was
;; written for.
(define
  (drifted files acc all)
  (cond
    ((null? files) acc)
    (else
      (let* ((f (car files)) (c (chart-of f)))
        (cond
          ((equal? c "") (drifted (cdr files) acc all))
          ;; the Chart.yaml itself changing is the bump — never a violation
          ((equal? f (chart-yaml-of c)) (drifted (cdr files) acc all))
          ;; a non-Chart.yaml change with NO Chart.yaml change in the same range
          ((and (not (list-contains? all (chart-yaml-of c)))
                (not (list-contains? acc c)))
            (drifted (cdr files) (cons c acc) all))
          (else (drifted (cdr files) acc all)))))))

(define
  (list-contains? lst item)
  (cond ((null? lst) #f) ((equal? (car lst) item) #t) (else (list-contains? (cdr lst) item))))

(define
  (report names)
  (cond
    ((null? names) #t)
    (else
      (log-error
        (string-append
          "  " (car names) " — edited with no Chart.yaml version change. "
          "auto-release will SKIP it as already-published and the edit ships "
          "NOWHERE. Bump charts/" (car names) "/Chart.yaml."))
      (report (cdr names)))))

(define
  (main)
  (cond
    ((or (equal? base "") (equal? head ""))
      ;; A missing range is a WIRING failure, not "no drift". Reporting 0
      ;; violations over an empty subject set is the exact class this gate
      ;; exists to catch, so refuse rather than pass.
      (log-error "bump-drift: BASE_SHA/HEAD_SHA not supplied — cannot compute a commit range")
      1)
    (else
      (let* ((files (changed-files)) (bad (drifted files (list) files)))
        (log-info
          (string-append
            "bump-drift: " (string-format "{}" (length files)) " changed file(s), "
            (string-format "{}" (length bad)) " chart(s) edited without a version bump"))
        ;; NO append-output. This runs through the GENERIC `tatara-script`
        ;; action, whose output-contract gate FAILS the step on any key it does
        ;; not declare -- and it cannot declare arbitrary consumer keys, since
        ;; every tlisp script in the fleet shares it. Measured on the first live
        ;; run (helmworks 0c4be69): the verdict was correct ("1 changed file(s),
        ;; 0 chart(s) edited without a version bump") and the step STILL exited
        ;; 1 on `drifted-count`, an output nothing consumes. A dedicated action
        ;; may declare its own outputs; a script borrowing the generic runner
        ;; may not. The count is in the log line above, where a human reads it.
        (cond
          ((null? bad) (log-info "bump-drift: no chart edited without a bump") 0)
          (else
            (log-error "bump-drift: charts edited WITHOUT a version bump:")
            (report bad)
            (if (equal? fail-on "true") 1 0)))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — bump-drift helpers loaded; main skipped"))
  (else (exit (main))))
