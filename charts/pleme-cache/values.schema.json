      "type": "string"
    },
    "global": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "health": {
      "allOf": [
        {
          "$ref": "#/definitions/Health"
        }
      ],
      "default": {
        "livenessFailureThreshold": 0,
        "livenessInitialDelay": 0,
        "livenessPeriod": 0,
        "readinessFailureThreshold": 0,
        "readinessInitialDelay": 0,
        "readinessPeriod": 0
      }
    },
    "image": {
      "$ref": "#/definitions/Image"
    },
    "imagePullSecrets": {
      "default": [],
      "items": {
        "$ref": "#/definitions/PullSecret"
      },
      "type": "array"
    },
    "istio": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "monitoring": {
      "allOf": [
        {
          "$ref": "#/definitions/Monitoring"
        }
      ],
      "default": {
        "enabled": false,
        "interval": "",
        "path": "",
        "port": "",
        "scrapeTimeout": ""
      }
    },
    "nameOverride": {
      "default": "",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "networkPolicy": {
      "allOf": [
        {
          "$ref": "#/definitions/NetworkPolicy"
        }
      ],
      "default": {
        "additionalEgress": [],
        "additionalIngress": [],
        "allowDns": false,
        "allowPrometheus": false,
        "enabled": false
      }
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "pleme-lib": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "podMonitor": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "ports": {
      "default": [],
      "items": true,
      "type": "array"
    },
    "priorityClassName": {
      "default": "",
      "type": "string"
    },
    "prometheusRules": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "format": "uint8",
      "maximum": 1.0,
      "minimum": 1.0,
