        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Bands whose driving metric is >5min stale. breathe never carves on a stale sample (never-OOM proof needs a fresh metric), so these are frozen at their current limit — fix the scrape, not the band."
    },
    {
      "id": 6,
      "title": "Conflicts /s",
