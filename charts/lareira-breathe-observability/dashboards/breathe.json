        {
          "refId": "A",
          "expr": "up{job=~\"breathe-controller-metrics|breathe-system/breathe-host-agent\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
        },
        "overrides": [

        ]
      },
      "options": {
      },
      "description": "Per (job,instance) scrape health. 1 = scraped + healthy, 0 = target DOWN. A job absent from this table is NOT WIRED (no scrape config) — that is the real cause of its panels' no-data."
    },
    {
      "id": 3,
      "title": "Targets down",
      "type": "stat",
      "gridPos": {
