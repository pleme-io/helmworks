        {
          "refId": "A",
          "expr": "count(up{job=~\"breathe-controller-metrics|breathe-system/breathe-host-agent\"} == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
