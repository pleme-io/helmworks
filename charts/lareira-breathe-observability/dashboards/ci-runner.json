    {
      "id": 2,
      "title": "Build OOM risk",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(breathe_band_util_ratio{name=\"arc-runner\",dim=\"memory\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Runner memory utilization (working-set / carved limit). >85% = a build is approaching its limit; breathe GROWS the limit (golden, restart-free) before OOM. Sustained ≈1.0 with no headroom left to grow (at ceiling) = raise the runner band ceiling."
    },
    {
      "id": 3,
      "title": "Band stale",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(breathe_band_staleness_seconds{name=\"arc-runner\"} > 300) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "The runner band's driving metric is >5min stale — breathe is flying blind on the runner (metrics-server gap). Distinct from Dormant (no runner): stale means a runner exists but is unobserved."
    },
    {
      "id": 4,
      "title": "Reclaimable headroom (Gi)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((breathe_band_current_limit{name=\"arc-runner\",dim=\"memory\"} - breathe_band_used{name=\"arc-runner\",dim=\"memory\"}) / 1073741824) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 12.0
              },
              {
                "color": "red",
                "value": 12.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "GiB the runner is over-provisioned by right now (carved limit − observed used). Large + persistent = the case for going live (lower the template + resizePolicy NotRequired) so breathe reclaims it. Informational — shadow never carves."
    },
