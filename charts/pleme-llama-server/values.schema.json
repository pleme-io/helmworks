{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "model", "server"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "model": {
      "type": "object",
      "required": ["path", "alias"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\.gguf$" },
        "alias": { "type": "string", "minLength": 1 }
      }
    },
    "draft": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^$|\\.gguf$" }
      }
    },
    "server": {
      "type": "object",
      "required": ["host", "port", "contextSize"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "contextSize": { "type": "integer", "minimum": 512 },
        "gpuLayers": { "type": "integer", "minimum": 0 },
        "flashAttn": { "type": "string", "enum": ["on", "off", "auto"] },
        "cacheTypeK": { "type": "string", "enum": ["f16", "bf16", "q8_0", "q4_0", "q4_1", "q5_0", "q5_1", "iq4_nl"] },
        "cacheTypeV": { "type": "string", "enum": ["f16", "bf16", "q8_0", "q4_0", "q4_1", "q5_0", "q5_1", "iq4_nl"] },
        "parallel": { "type": "integer", "minimum": 1 },
        "cacheReuse": { "type": "integer", "minimum": 0 },
        "jinja": { "type": "boolean" },
        "metrics": { "type": "boolean" }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "home": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 }
  }
}
