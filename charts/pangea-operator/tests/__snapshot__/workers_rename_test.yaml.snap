  3: |
    apiVersion: v1
    data:
      consumer-PANGEA_LEAF-leaf-github-pleme-io.json: |
        {
          "stream_name": "PANGEA_LEAF",
          "config": {
            "durable_name": "leaf-github-pleme-io",
            "ack_policy": "explicit",
            "ack_wait": 60000000000,
            "max_ack_pending": 4,
            "max_deliver": 5,
            "filter_subject": "pangea.leaf.github-pleme-io.>",
            "replay_policy": "instant"
          }
        }
      stream-PANGEA_LEAF.json: |
        {
          "name": "PANGEA_LEAF",
          "subjects": ["pangea.leaf.\u003e"],
          "retention": "workqueue",
          "storage": "file",
          "num_replicas": 1,
          "max_consumers": -1,
          "max_msgs": -1,
          "max_msgs_per_subject": -1,
          "max_bytes": -1,
          "max_msg_size": -1,
          "max_age": 0,
          "duplicate_window": 600000000000,
          "discard": "old"
        }
    kind: ConfigMap
    metadata:
      annotations:
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
        helm.sh/hook-weight: "-5"
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
        pleme.io/jetstream-config: "true"
      name: pangea-operator-jetstream
      namespace: pangea-system
  4: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
        helm.sh/hook-weight: "5"
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
        pleme.io/jetstream-init: "true"
      name: pangea-operator-jetstream-init
      namespace: pangea-system
    spec:
      backoffLimit: 3
      template:
        metadata:
          labels:
            app.kubernetes.io/component: jetstream-init
            app.kubernetes.io/instance: pangea-operator
            app.kubernetes.io/name: pangea-operator
        spec:
          containers:
            - command:
                - /bin/sh
                - -ec
                - |
                  echo "Waiting up to ${SERVER_WAIT_SECONDS}s for NATS at ${NATS_URL}..."
                  i=0
                  until nats --server "${NATS_URL}" account info >/dev/null 2>&1; do
                    i=$((i+1))
                    if [ "$i" -ge "${SERVER_WAIT_SECONDS}" ]; then
                      echo "Gave up waiting for NATS"
                      exit 1
                    fi
                    sleep 1
                  done
                  echo "NATS reachable. Declaring streams..."
                  for f in /configs/stream-*.json; do
                    [ -f "$f" ] || continue
                    name=$(basename "$f" .json | sed 's/^stream-//')
                    echo "  → stream: $name"
                    # `--force` skips interactive confirmation when the
                    # stream already exists with a different configuration.
                    # Idempotent upsert: try add first, fall through to
                    # update if it already exists.
                    nats --server "${NATS_URL}" stream add --config "$f" "$name" 2>/dev/null \
                      || nats --server "${NATS_URL}" stream update --force --config "$f" "$name"
                  done
                  echo "Declaring consumers..."
                  for f in /configs/consumer-*.json; do
                    [ -f "$f" ] || continue
                    base=$(basename "$f" .json | sed 's/^consumer-//')
                    stream=$(echo "$base" | cut -d- -f1)
                    consumer=$(echo "$base" | cut -d- -f2-)
                    echo "  → consumer: $stream/$consumer"
                    nats --server "${NATS_URL}" consumer add --config "$f" "$stream" "$consumer" 2>/dev/null \
                      || nats --server "${NATS_URL}" consumer update --force --config "$f" "$stream" "$consumer"
                  done
                  echo "Done."
              env:
                - name: NATS_URL
                  value: nats://pangea-leaf-nats.pangea-system.svc:4222
                - name: SERVER_WAIT_SECONDS
                  value: "120"
                - name: HOME
                  value: /tmp
              image: natsio/nats-box:0.14.5
              imagePullPolicy: IfNotPresent
              name: jetstream-init
              resources:
                limits:
                  cpu: 100m
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /configs
                  name: configs
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
              workingDir: /tmp
          restartPolicy: OnFailure
          securityContext:
            fsGroup: 1000
            runAsNonRoot: true
            runAsUser: 1000
          volumes:
            - configMap:
                name: pangea-operator-jetstream
              name: configs
            - emptyDir:
                sizeLimit: 32Mi
              name: tmp
      ttlSecondsAfterFinished: 300
