the KEDA tofu pools under tofuWorkers render what workers rendered:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
      name: pangea-operator
      namespace: pangea-system
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: pangea-operator
          app.kubernetes.io/name: pangea-operator
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            prometheus.io/path: /metrics
            prometheus.io/port: "9090"
            prometheus.io/scrape: "true"
          labels:
            app: pangea-operator
            app.kubernetes.io/instance: pangea-operator
            app.kubernetes.io/name: pangea-operator
        spec:
          automountServiceAccountToken: true
          containers:
            - env:
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: RUST_LOG
                  value: pangea_operator=info
                - name: TOFU_BINARY
                  value: /usr/local/bin/tofu
                - name: PANGEA_FORBID_TOFU
                  value: "true"
                - name: PANGEA_TIMEOUT
                  value: "600"
                - name: PACKER_BINARY
                  value: /usr/local/bin/packer
                - name: PACKER_TIMEOUT
                  value: "2700"
                - name: PANGEA_WORKSPACE_BASE
                  value: /var/pangea/workspaces
                - name: COMPILER_ENDPOINT
                  value: http://localhost:8082
                - name: PANGEA_COMPILER_BACKEND
                  value: lava
                - name: PANGEA_LAVA_RUBY
                  value: "on"
                - name: PANGEA_GEM_CACHE_DIR
                  value: /var/pangea/gems
                - name: PANGEA_RUBY_WORKERS
                  value: "1"
                - name: PANGEA_HONOR_RECONCILE_REQUESTS
                  value: "false"
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
              image: ghcr.io/pleme-io/pangea-operator:0.8.17
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 5
                periodSeconds: 10
                timeoutSeconds: 1
              name: pangea-operator
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
                - containerPort: 9090
                  name: metrics
                  protocol: TCP
                - containerPort: 8081
                  name: graphql
                  protocol: TCP
              readinessProbe:
                failureThreshold: 2
                httpGet:
                  path: /readyz
                  port: http
                initialDelaySeconds: 5
                periodSeconds: 5
                timeoutSeconds: 1
              resources:
                limits:
                  cpu: "1"
                  memory: 512Mi
                requests:
                  cpu: 200m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 5
                periodSeconds: 5
              volumeMounts:
                - mountPath: /var/pangea/workspaces
                  name: workspaces
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 1000
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: pangea-operator
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir:
                sizeLimit: 2Gi
              name: workspaces
            - emptyDir:
                sizeLimit: 256Mi
              name: tmp
  2: |
    apiVersion: keda.sh/v1alpha1
    kind: ScaledObject
    metadata:
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
        pangea.pleme.io/work-class: medium
      name: pangea-operator-worker-medium
    spec:
      cooldownPeriod: 120
      maxReplicaCount: 10
      minReplicaCount: 0
      pollingInterval: 15
      scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: pangea-operator-workerMedium
      triggers:
        - metadata:
            metricName: pangea_workunit_pending_medium
            query: sum(pangea_workunit_pending_total{work_class="medium"})
            serverAddress: http://vmsingle-vm.monitoring.svc:8429
            threshold: "1"
          type: prometheus
  3: |
    apiVersion: keda.sh/v1alpha1
    kind: ScaledObject
    metadata:
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
        pangea.pleme.io/work-class: small
      name: pangea-operator-worker-small
    spec:
      cooldownPeriod: 120
      maxReplicaCount: 5
      minReplicaCount: 0
      pollingInterval: 15
      scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: pangea-operator-workerSmall
      triggers:
        - metadata:
            metricName: pangea_workunit_pending_small
            query: sum(pangea_workunit_pending_total{work_class="small"})
            serverAddress: http://vmsingle-vm.monitoring.svc:8429
            threshold: "1"
          type: prometheus
  4: |
    apiVersion: pangea.pleme.io/v1alpha1
    kind: PangeaWorkClass
    metadata:
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
      name: medium
    spec:
      concurrencyPerWorker: 1
      resources:
        limits:
          cpu: "2"
          memory: 2Gi
        requests:
          cpu: 500m
          memory: 1Gi
      timeout: 15m
      workerImage:
        pullPolicy: IfNotPresent
        repository: ghcr.io/pleme-io/pangea-operator-worker
        tag: 0.8.17
  5: |
    apiVersion: pangea.pleme.io/v1alpha1
    kind: PangeaWorkClass
    metadata:
      labels:
        app: pangea-operator
        app.kubernetes.io/instance: pangea-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: pangea-operator
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.8.17
        helm.sh/chart: pangea-operator-0.9.25
      name: small
    spec:
      concurrencyPerWorker: 1
      resources:
        limits:
          cpu: "1"
          memory: 1Gi
        requests:
          cpu: 100m
          memory: 256Mi
      timeout: 5m
      workerImage:
        pullPolicy: IfNotPresent
        repository: ghcr.io/pleme-io/pangea-operator-worker
        tag: 0.8.17
