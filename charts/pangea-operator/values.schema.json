{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "useEmbeddedRuby": {
            "const": true
          }
        },
        "required": [
          "useEmbeddedRuby"
        ]
      },
      "then": {
        "properties": {
          "gemAuth": {
            "properties": {
              "tokenSecret": {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "tokenSecret"
            ]
          }
        },
        "required": [
          "gemAuth"
        ]
      }
    }
  ],
  "definitions": {
    "ControllerSuspendValues": {
      "description": "Per-controller suspend flags. Each maps to a ControllerKind variant.",
      "properties": {
        "amiTest": {
          "default": false,
          "type": "boolean"
        },
        "architectureGem": {
          "default": false,
          "type": "boolean"
        },
        "complianceBinding": {
          "default": false,
          "type": "boolean"
        },
        "complianceSchedule": {
          "default": false,
          "type": "boolean"
        },
        "dashboard": {
          "default": false,
          "type": "boolean"
        },
        "flow": {
          "default": false,
          "type": "boolean"
        },
        "imagePipeline": {
          "default": false,
          "type": "boolean"
        },
        "namespace": {
          "default": false,
          "type": "boolean"
        },
        "packerBuild": {
          "default": false,
          "type": "boolean"
        },
        "synthesizerFormat": {
          "default": false,
          "type": "boolean"
        },
        "template": {
          "default": false,
          "type": "boolean"
        },
        "workspaceCatalog": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GemAuth": {
      "properties": {
        "tokenSecret": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenSecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "OperatorPolicyValues": {
      "properties": {
        "controllerSuspend": {
          "allOf": [
            {
              "$ref": "#/definitions/ControllerSuspendValues"
            }
          ],
          "default": {
            "amiTest": false,
            "architectureGem": false,
            "complianceBinding": false,
            "complianceSchedule": false,
            "dashboard": false,
            "flow": false,
            "imagePipeline": false,
            "namespace": false,
            "packerBuild": false,
            "synthesizerFormat": false,
            "template": false,
            "workspaceCatalog": false
          },
          "description": "Per-controller suspend."
        },
        "create": {
          "default": true,
          "description": "Whether to render the OperatorPolicy/default CR.",
          "type": "boolean"
        },
        "globalSuspend": {
          "default": false,
          "description": "Master kill-switch.",
          "type": "boolean"
        },
        "globalSuspendReason": {
          "default": "",
          "description": "Operator-readable reason surfaced in logs + Events when global_suspend=true.",
          "type": "string"
        },
        "workspaceSuspend": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceSuspendValues"
            }
          ],
          "default": {
            "catalogs": {},
            "templates": {}
          },
          "description": "Per-workspace tri-state suspend."
        }
      },
      "type": "object"
    },
    "ToggleSection": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "TokenSecretRef": {
      "properties": {
        "key": {
          "default": "token",
          "description": "Key within the Secret. Defaults to \"token\".",
          "type": "string"
        },
        "name": {
          "description": "Secret name. Required-non-empty when use_embedded_ruby=true (enforced via the generator's post-process step).",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WorkspaceState": {
      "description": "Tri-state per-workspace pause directive (mirror of crd::WorkspaceState).",
      "enum": [
        "inherit",
        "paused",
        "active"
      ],
      "type": "string"
    },
    "WorkspaceSuspendEntry": {
      "properties": {
        "reason": {
          "description": "Optional human-readable reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceState"
            }
          ],
          "default": "inherit",
          "description": "Tri-state pause directive."
        }
      },
      "type": "object"
    },
    "WorkspaceSuspendValues": {
      "properties": {
        "catalogs": {
          "additionalProperties": {
            "$ref": "#/definitions/WorkspaceSuspendEntry"
          },
          "default": {},
          "description": "Per-catalog overrides keyed by WorkspaceCatalog name.",
          "type": "object"
        },
        "templates": {
          "additionalProperties": {
            "$ref": "#/definitions/WorkspaceSuspendEntry"
          },
          "default": {},
          "description": "Per-template overrides keyed `\"<namespace>/<name>\"`.",
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "description": "Top-level pangea-operator chart values.",
  "properties": {
    "gemAuth": {
      "allOf": [
        {
          "$ref": "#/definitions/GemAuth"
        }
      ],
      "default": {
        "tokenSecret": null
      },
      "description": "Authentication for fetching operator-runtime gems (only consulted when use_embedded_ruby=true)."
    },
    "logLevel": {
      "default": "pangea_operator=info",
      "description": "tracing-subscriber EnvFilter directive, threaded into RUST_LOG by the deployment template (Q4 / chart 0.8.5).",
      "type": "string"
    },
    "monitoring": {
      "allOf": [
        {
          "$ref": "#/definitions/ToggleSection"
        }
      ],
      "default": {
        "enabled": true
      },
      "description": "Observability toggles (chart-side; the operator's own metrics are always emitted)."
    },
    "operatorPolicy": {
      "allOf": [
        {
          "$ref": "#/definitions/OperatorPolicyValues"
        }
      ],
      "default": {
        "controllerSuspend": {
          "amiTest": false,
          "architectureGem": false,
          "complianceBinding": false,
          "complianceSchedule": false,
          "dashboard": false,
          "flow": false,
          "imagePipeline": false,
          "namespace": false,
          "packerBuild": false,
          "synthesizerFormat": false,
          "template": false,
          "workspaceCatalog": false
        },
        "create": false,
        "globalSuspend": false,
        "globalSuspendReason": "",
        "workspaceSuspend": {
          "catalogs": {},
          "templates": {}
        }
      },
      "description": "OperatorPolicy/default singleton CR config."
    },
    "prometheusRules": {
      "allOf": [
        {
          "$ref": "#/definitions/ToggleSection"
        }
      ],
      "default": {
        "enabled": true
      },
      "description": "PrometheusRule CR rendering toggle."
    },
    "useEmbeddedRuby": {
      "default": false,
      "description": "When true, operator runs the magnus+CRuby compiler in-process (no sidecar). Requires `gem_auth.token_secret.name` to be set to a non-empty Secret name.",
      "type": "boolean"
    }
  },
  "title": "ChartValues",
  "type": "object"
}