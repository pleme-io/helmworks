{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "useEmbeddedRuby": {
            "const": true
          }
        },
        "required": [
          "useEmbeddedRuby"
        ]
      },
      "then": {
        "properties": {
          "gemAuth": {
            "properties": {
              "tokenSecret": {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "tokenSecret"
            ]
          }
        },
        "required": [
          "gemAuth"
        ]
      }
    }
  ],
  "definitions": {
    "CompilerBackendChoice": {
      "enum": [
        "",
        "lava",
        "embedded",
        "process",
        "http"
      ],
      "type": "string"
    },
    "ControllerSuspendValues": {
      "description": "Per-controller suspend flags. Each maps to a ControllerKind variant.",
      "properties": {
        "amiTest": {
          "default": false,
          "type": "boolean"
        },
        "architectureGem": {
          "default": false,
          "type": "boolean"
        },
        "complianceBinding": {
          "default": false,
          "type": "boolean"
        },
        "complianceSchedule": {
          "default": false,
          "type": "boolean"
        },
        "dashboard": {
          "default": false,
          "type": "boolean"
        },
        "flow": {
          "default": false,
          "type": "boolean"
        },
        "imagePipeline": {
          "default": false,
          "type": "boolean"
        },
        "namespace": {
          "default": false,
          "type": "boolean"
        },
        "packerBuild": {
          "default": false,
          "type": "boolean"
        },
        "synthesizerFormat": {
          "default": false,
          "type": "boolean"
        },
        "template": {
          "default": false,
          "type": "boolean"
        },
        "workspaceCatalog": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GemAuth": {
      "properties": {
        "tokenSecret": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenSecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "LavaRubyValues": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "loadPath": {
          "default": "",
          "description": "PANGEA_LAVA_RUBY_LOAD_PATH: colon-separated gem lib dirs. Empty uses every <gem>/lib under /usr/share/lava/ruby, the closure the operator image bakes in.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LeafAutoscaling": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "false renders no HPA and fixed workers.replicas.",
          "type": "boolean"
        },
        "horizonSecs": {
          "default": 300,
          "description": "H: each credential's pending work is capped at its rate times H.",
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        },
        "max": {
          "default": 4,
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        },
        "min": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scaleDownStabilizationSecs": {
          "default": 300,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "target": {
          "default": 600,
          "description": "T: weighted pending leaf work per replica (pangea_leaf_pending_work).",
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LeafCredential": {
      "properties": {
        "cap": {
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "cap",
        "name"
      ],
      "type": "object"
    },
    "LeafJetStream": {
      "properties": {
        "ackWait": {
          "default": "60s",
          "type": "string"
        },
        "declare": {
          "default": true,
          "description": "Declare the stream and consumers with the chart's init Job (an OCI nats-box image). false where the node runs no OCI image (engenho native).",
          "type": "boolean"
        },
        "duplicateWindow": {
          "default": "10m",
          "type": "string"
        },
        "maxDeliver": {
          "default": 5,
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        },
        "stream": {
          "default": "PANGEA_LEAF",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LeafNats": {
      "properties": {
        "auth": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafNatsAuth"
            }
          ],
          "default": {
            "passwordKey": "password",
            "secretName": "",
            "userKey": "user"
          }
        },
        "url": {
          "default": "",
          "description": "nats:// URL of the JetStream broker. Empty with queue: jetstream refuses that entry alone: no worker, HPA or stream renders and the leader stays in process.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LeafNatsAuth": {
      "properties": {
        "passwordKey": {
          "default": "password",
          "type": "string"
        },
        "secretName": {
          "default": "",
          "description": "Secret holding the broker user and password. Empty connects without auth.",
          "type": "string"
        },
        "userKey": {
          "default": "user",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LeafQueue": {
      "enum": [
        "in_process",
        "jetstream"
      ],
      "type": "string"
    },
    "LeafValues": {
      "properties": {
        "credentials": {
          "default": [],
          "description": "One durable JetStream consumer per credential, subject pangea.leaf.<name>.>, MaxAckPending = cap.",
          "items": {
            "$ref": "#/definitions/LeafCredential"
          },
          "type": "array"
        },
        "jetstream": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafJetStream"
            }
          ],
          "default": {
            "ackWait": "60s",
            "declare": true,
            "duplicateWindow": "10m",
            "maxDeliver": 5,
            "stream": "PANGEA_LEAF"
          }
        },
        "nats": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafNats"
            }
          ],
          "default": {
            "auth": {
              "passwordKey": "password",
              "secretName": "",
              "userKey": "user"
            },
            "url": ""
          }
        },
        "queue": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafQueue"
            }
          ],
          "default": "in_process"
        },
        "workers": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafWorkers"
            }
          ],
          "default": {
            "autoscaling": {
              "enabled": true,
              "horizonSecs": 300,
              "max": 4,
              "min": 0,
              "scaleDownStabilizationSecs": 300,
              "target": 600
            },
            "derivation": {
              "baseMi": 24,
              "concurrency": 4,
              "leafPeakMi": 56,
              "providerMi": 33,
              "providers": 1
            },
            "memory": "derived",
            "replicas": 0
          }
        }
      },
      "type": "object"
    },
    "LeafWorkers": {
      "properties": {
        "autoscaling": {
          "allOf": [
            {
              "$ref": "#/definitions/LeafAutoscaling"
            }
          ],
          "default": {
            "enabled": true,
            "horizonSecs": 300,
            "max": 4,
            "min": 0,
            "scaleDownStabilizationSecs": 300,
            "target": 600
          }
        },
        "derivation": {
          "allOf": [
            {
              "$ref": "#/definitions/MemoryDerivation"
            }
          ],
          "default": {
            "baseMi": 24,
            "concurrency": 4,
            "leafPeakMi": 56,
            "providerMi": 33,
            "providers": 1
          }
        },
        "memory": {
          "default": "derived",
          "description": "derived: request = baseMi + concurrency * leafPeakMi + providers * providerMi, limit = 1.5 * request. A quantity sets both.",
          "pattern": "^(derived|[1-9][0-9]*(Mi|Gi))$",
          "type": "string"
        },
        "replicas": {
          "default": 0,
          "description": "Fixed replicas when autoscaling.enabled is false.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MemoryDerivation": {
      "properties": {
        "baseMi": {
          "default": 24,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "concurrency": {
          "default": 4,
          "format": "uint32",
          "minimum": 1.0,
          "type": "integer"
        },
        "leafPeakMi": {
          "default": 56,
          "description": "Largest status.leaf.peakRssBytes in MiB; the fat-plan peak (55.6 MiB) until calibration.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "providerMi": {
          "default": 33,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "providers": {
          "default": 1,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OperatorPolicyValues": {
      "properties": {
        "controllerSuspend": {
          "allOf": [
            {
              "$ref": "#/definitions/ControllerSuspendValues"
            }
          ],
          "default": {
            "amiTest": false,
            "architectureGem": false,
            "complianceBinding": false,
            "complianceSchedule": false,
            "dashboard": false,
            "flow": false,
            "imagePipeline": false,
            "namespace": false,
            "packerBuild": false,
            "synthesizerFormat": false,
            "template": false,
            "workspaceCatalog": false
          },
          "description": "Per-controller suspend."
        },
        "create": {
          "default": true,
          "description": "Whether to render the OperatorPolicy/default CR.",
          "type": "boolean"
        },
        "globalSuspend": {
          "default": false,
          "description": "Master kill-switch.",
          "type": "boolean"
        },
        "globalSuspendReason": {
          "default": "",
          "description": "Operator-readable reason surfaced in logs + Events when global_suspend=true.",
          "type": "string"
        },
        "workspaceSuspend": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceSuspendValues"
            }
          ],
          "default": {
            "catalogs": {},
            "templates": {}
          },
          "description": "Per-workspace tri-state suspend."
        }
      },
      "type": "object"
    },
    "ToggleSection": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "TokenSecretRef": {
      "properties": {
        "key": {
          "default": "token",
          "description": "Key within the Secret. Defaults to \"token\".",
          "type": "string"
        },
        "name": {
          "description": "Secret name. Required-non-empty when use_embedded_ruby=true (enforced via the generator's post-process step).",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WorkspaceState": {
      "description": "Tri-state per-workspace pause directive (mirror of crd::WorkspaceState).",
      "enum": [
        "inherit",
        "paused",
        "active"
      ],
      "type": "string"
    },
    "WorkspaceSuspendEntry": {
      "properties": {
        "reason": {
          "description": "Optional human-readable reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceState"
            }
          ],
          "default": "inherit",
          "description": "Tri-state pause directive."
        }
      },
      "type": "object"
    },
    "WorkspaceSuspendValues": {
      "properties": {
        "catalogs": {
          "additionalProperties": {
            "$ref": "#/definitions/WorkspaceSuspendEntry"
          },
          "default": {},
          "description": "Per-catalog overrides keyed by WorkspaceCatalog name.",
          "type": "object"
        },
        "templates": {
          "additionalProperties": {
            "$ref": "#/definitions/WorkspaceSuspendEntry"
          },
          "default": {},
          "description": "Per-template overrides keyed `\"<namespace>/<name>\"`.",
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "description": "Top-level pangea-operator chart values.",
  "properties": {
    "compilerBackend": {
      "allOf": [
        {
          "$ref": "#/definitions/CompilerBackendChoice"
        }
      ],
      "default": "",
      "description": "Compiler backend: lava (default when unset and useEmbeddedRuby is false), embedded, process or http. Empty derives it from useEmbeddedRuby/rubyIsolation."
    },
    "gemAuth": {
      "allOf": [
        {
          "$ref": "#/definitions/GemAuth"
        }
      ],
      "default": {
        "tokenSecret": null
      },
      "description": "Authentication for fetching operator-runtime gems (only consulted when use_embedded_ruby=true)."
    },
    "lavaRuby": {
      "allOf": [
        {
          "$ref": "#/definitions/LavaRubyValues"
        }
      ],
      "default": {
        "enabled": true,
        "loadPath": ""
      },
      "description": "Ruby templates compiled by the lava backend's contained interpreter (PANGEA_LAVA_RUBY). On by default; enabled: false refuses them with a typed error."
    },
    "leaf": {
      "allOf": [
        {
          "$ref": "#/definitions/LeafValues"
        }
      ],
      "default": {
        "credentials": [],
        "jetstream": {
          "ackWait": "60s",
          "declare": true,
          "duplicateWindow": "10m",
          "maxDeliver": 5,
          "stream": "PANGEA_LEAF"
        },
        "nats": {
          "auth": {
            "passwordKey": "password",
            "secretName": "",
            "userKey": "user"
          },
          "url": ""
        },
        "queue": "in_process",
        "workers": {
          "autoscaling": {
            "enabled": true,
            "horizonSecs": 300,
            "max": 4,
            "min": 0,
            "scaleDownStabilizationSecs": 300,
            "target": 600
          },
          "derivation": {
            "baseMi": 24,
            "concurrency": 4,
            "leafPeakMi": 56,
            "providerMi": 33,
            "providers": 1
          },
          "memory": "derived",
          "replicas": 0
        }
      },
      "description": "Leaf work queue, leaf workers and their autoscaling (pangea-operator docs/LEAVES.md §17). queue: in_process renders no worker, no HPA and no stream."
    },
    "logLevel": {
      "default": "pangea_operator=info",
      "description": "tracing-subscriber EnvFilter directive, threaded into RUST_LOG by the deployment template (Q4 / chart 0.8.5).",
      "type": "string"
    },
    "monitoring": {
      "allOf": [
        {
          "$ref": "#/definitions/ToggleSection"
        }
      ],
      "default": {
        "enabled": true
      },
      "description": "Observability toggles (chart-side; the operator's own metrics are always emitted)."
    },
    "operatorPolicy": {
      "allOf": [
        {
          "$ref": "#/definitions/OperatorPolicyValues"
        }
      ],
      "default": {
        "controllerSuspend": {
          "amiTest": false,
          "architectureGem": false,
          "complianceBinding": false,
          "complianceSchedule": false,
          "dashboard": false,
          "flow": false,
          "imagePipeline": false,
          "namespace": false,
          "packerBuild": false,
          "synthesizerFormat": false,
          "template": false,
          "workspaceCatalog": false
        },
        "create": false,
        "globalSuspend": false,
        "globalSuspendReason": "",
        "workspaceSuspend": {
          "catalogs": {},
          "templates": {}
        }
      },
      "description": "OperatorPolicy/default singleton CR config."
    },
    "prometheusRules": {
      "allOf": [
        {
          "$ref": "#/definitions/ToggleSection"
        }
      ],
      "default": {
        "enabled": true
      },
      "description": "PrometheusRule CR rendering toggle."
    },
    "useEmbeddedRuby": {
      "default": false,
      "description": "When true, operator runs the magnus+CRuby compiler in-process (no sidecar). Requires `gem_auth.token_secret.name` to be set to a non-empty Secret name.",
      "type": "boolean"
    }
  },
  "title": "ChartValues",
  "type": "object"
}