    {
      "id": 2,
      "title": "vmagent scrape failures /s",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vm_promscrape_scrapes_failed_total[5m])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Scrapes that failed across all vmagent targets. >0 = some exporter is unreachable or erroring; that target is going dark in the TSDB right now."
