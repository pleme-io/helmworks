      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Nodes with <10% memory available — the OOM killer is near. breathe carves container limits; this is the host envelope."
    },
    {
      "id": 5,
      "title": "CPU saturation %",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85.0
              },
              {
                "color": "red",
                "value": 95.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Busiest node CPU utilisation. Sustained >85% = throttling; >95% = the node is the bottleneck."
    },
    {
      "id": 6,
      "title": "Load per core",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(node_load1 / on (instance) group_left count by (instance) (node_cpu_seconds_total{mode=\"idle\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 4.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "load1 ÷ cores. >1 = more runnable work than cores; >4 = severe contention (the node feels frozen)."
    },
