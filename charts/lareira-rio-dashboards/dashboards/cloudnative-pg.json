    {
      "id": 2,
      "title": "Clusters unhealthy",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cnpg_collector_up == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "CNPG instances whose metrics exporter / Postgres is down (cnpg_collector_up == 0). pangea-database is the operator's state store — a down instance freezes every reconcile. Red = an instance is unreachable NOW."
    },
    {
      "id": 3,
      "title": "Replicas not streaming",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(count(cnpg_pg_replication_in_recovery == 1) - max(cnpg_pg_replication_streaming_replicas), 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Standbys (in recovery) that the primary does not see as a streaming replica. CNPG exposes no expected-replicas metric, so this is standbys-present minus the primary's streaming-replica count. >0 = a standby fell off replication."
    },
    {
      "id": 4,
      "title": "Replication lag (s)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cnpg_pg_replication_lag) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5.0
              },
              {
                "color": "red",
                "value": 30.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Worst standby replay lag behind the primary. >5s = the replica is behind; >30s = a failover would lose meaningful committed work."
    },
    {
      "id": 5,
      "title": "Connections near max %",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * sum by (pod)(cnpg_backends_total) / on(pod) cnpg_pg_settings_setting{name=\"max_connections\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80.0
              },
              {
                "color": "red",
                "value": 95.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Busiest instance's active+idle backends as a % of max_connections. >80% = the pool is near exhaustion; >95% = new connections (incl. the operator's) will start being refused."
    },
    {
      "id": 6,
      "title": "Deadlocks /s",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cnpg_pg_stat_database_deadlocks[5m])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "Rate of detected deadlocks across all databases. Any sustained >0 = transactions are colliding on lock order — an application contention bug, not a DB capacity issue."
    },
    {
      "id": 7,
      "title": "Storage near full %",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * (1 - kubelet_volume_stats_available_bytes{namespace=\"pangea-system\"} / kubelet_volume_stats_capacity_bytes{namespace=\"pangea-system\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80.0
              },
              {
                "color": "red",
                "value": 90.0
              }
            ]
          }
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area"
      },
      "description": "PG data-volume fullness. NOTE: rio's PVCs are local-path, whose kubelet_volume_stats report the WHOLE NODE FILESYSTEM, not the per-volume usage (the breathe MetricUnrepresentable finding) — both pangea-database PVCs read identical node-disk free, so this reflects node disk, not the PG volume itself."
    },
