{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "content": {
            "properties": {
              "placeholder": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "placeholder"
            ]
          }
        },
        "required": [
          "content"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "image": {
                "properties": {
                  "repository": {
                    "minLength": 1
                  },
                  "tag": {
                    "minLength": 1
                  }
                },
                "required": [
                  "repository",
                  "tag"
                ]
              }
            },
            "required": [
              "image"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/Image"
            }
          ],
          "default": {
            "repository": "",
            "tag": ""
          }
        },
        "placeholder": {
          "allOf": [
            {
              "$ref": "#/definitions/Placeholder"
            }
          ],
          "default": {
            "enabled": true
          }
        }
      },
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "pattern": "^$|^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*(@sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "tag": {
          "default": "",
          "not": {
            "const": "latest"
          },
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$|^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "Placeholder": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ],
      "type": "string"
    },
    "PullSecret": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Quantities": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$",
          "type": "string"
        },
        "memory": {
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$",
          "type": "string"
        }
      },
      "required": [
        "cpu",
        "memory"
      ],
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/definitions/Quantities"
        },
        "requests": {
          "$ref": "#/definitions/Quantities"
        }
      },
      "required": [
        "limits",
        "requests"
      ],
      "type": "object"
    },
    "Server": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/Image"
            }
          ],
          "default": {
            "repository": "ghcr.io/pleme-io/hanabi",
            "tag": ""
          }
        },
        "pullPolicy": {
          "allOf": [
            {
              "$ref": "#/definitions/PullPolicy"
            }
          ],
          "default": "IfNotPresent"
        }
      },
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "default": 8080,
          "format": "uint16",
          "maximum": 65534.0,
          "minimum": 1024.0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "company": {
      "maxLength": 30,
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$",
      "type": "string"
    },
    "content": {
      "allOf": [
        {
          "$ref": "#/definitions/Content"
        }
      ],
      "default": {
        "image": {
          "repository": "",
          "tag": ""
        },
        "placeholder": {
          "enabled": true
        }
      }
    },
    "fullnameOverride": {
      "default": "",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "hosts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "imagePullSecrets": {
      "default": [],
      "items": {
        "$ref": "#/definitions/PullSecret"
      },
      "type": "array"
    },
    "nameOverride": {
      "default": "",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "pathPrefix": {
      "default": "/",
      "pattern": "^(/|(/[a-z0-9][a-z0-9._~-]*)+)$",
      "type": "string"
    },
    "pleme-lib": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "format": "uint8",
      "maximum": 10.0,
      "minimum": 1.0,
      "type": "integer"
    },
    "resources": {
      "allOf": [
        {
          "$ref": "#/definitions/Resources"
        }
      ],
      "default": {
        "limits": {
          "cpu": "200m",
          "memory": "64Mi"
        },
        "requests": {
          "cpu": "10m",
          "memory": "16Mi"
        }
      }
    },
    "server": {
      "allOf": [
        {
          "$ref": "#/definitions/Server"
        }
      ],
      "default": {
        "image": {
          "repository": "ghcr.io/pleme-io/hanabi",
          "tag": ""
        },
        "pullPolicy": "IfNotPresent"
      }
    },
    "service": {
      "allOf": [
        {
          "$ref": "#/definitions/Service"
        }
      ],
      "default": {
        "port": 8080
      }
    }
  },
  "required": [
    "company",
    "hosts"
  ],
  "title": "EmpresaSiteValues",
  "type": "object"
}
