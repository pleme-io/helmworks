{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shaar-concentrator values",
  "description": "Typed authoring surface for the Shaar VPN concentrator (server end). additionalProperties:false everywhere — an unknown/misspelled key is rejected at install time instead of being silently dropped by Helm.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm cross-chart global value namespace (passthrough)."
    },
    "pleme-lib": {
      "type": "object",
      "description": "Library-subchart value namespace coalesced by Helm; opaque to this chart's typed surface."
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "description": "MUST stay empty — hostNetwork + NET_ADMIN + root hard-fail any FedRAMP baseline.",
      "properties": {
        "baseline": { "type": "string", "enum": [""] }
      }
    },
    "fullnameOverride": { "type": "string" },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Recreate", "RollingUpdate"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["", "Always", "IfNotPresent", "Never"] }
      }
    },
    "localImport": { "type": "boolean" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr"],
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
        }
      }
    },
    "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "public_endpoint": {
      "type": "string",
      "description": "Empty ⇒ IMDS self-discovery. Else ip:port."
    },
    "reach": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
          }
        }
      }
    },
    "leaseTtlSecs": { "type": "integer", "minimum": 1 },
    "gcIntervalSecs": { "type": "integer", "minimum": 1 },
    "engine": { "enum": ["kernel", "userspace"] },
    "selfMasquerade": { "type": "boolean" },
    "tunnelName": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseQuota": { "type": ["integer", "string"] },
        "reachCeilings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "bind": { "type": "string", "minLength": 1 },
        "expose": { "type": "boolean" },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "credsKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "credsKey": { "type": "string", "minLength": 1 },
        "tokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pvcSize": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDns": { "type": "boolean" },
        "allowPrometheus": { "type": "boolean" },
        "additionalIngress": { "type": "array", "items": { "type": "object" } },
        "additionalEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "breathe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "memory": { "type": "object" },
        "cpu": { "type": "object" },
        "targetRef": { "type": "object" }
      }
    }
  }
}
