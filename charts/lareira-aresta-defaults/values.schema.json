{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "clusterRoleName": { "type": "string", "minLength": 1 },
    "podMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "interval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alert", "expr"],
            "properties": {
              "alert": { "type": "string" },
              "expr": { "type": "string" },
              "for": { "type": "string" },
              "labels": { "type": "object" },
              "annotations": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
