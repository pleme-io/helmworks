  9: |
    apiVersion: v1
    data:
      config.yaml: |
        identity:
          peer_allowlist:
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-cartorio"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-lacre"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-publisher-pki"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-scanner"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-skill-store"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-web"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-backing-registry"
            - "spiffe://pleme.io/ns/cloudflared/sa/cloudflared"
          upstream_allowlist:
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-cartorio"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-lacre"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-publisher-pki"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-scanner"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-skill-store"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-openclaw-web"
            - "spiffe://pleme.io/ns/openclaw/sa/openclaw-stack-backing-registry"
            - "spiffe://pleme.io/ns/cloudflared/sa/cloudflared"
          workload_api_socket: null
          # SVID lifecycle. `oneshot` (default) fetches once at startup;
          # `streaming` subscribes to the SPIFFE Workload API stream and
          # hot-swaps the TLS contexts on every rotation update from the
          # agent, eliminating the daily cert-expiry restart cycle.
          rotation: "oneshot"
        inbound_addr: "0.0.0.0:15001"
        outbound_addr: "0.0.0.0:15006"
        probe_addr: "0.0.0.0:4191"
        observability:
          log_format: "json"
          metrics_addr: "0.0.0.0:9090"
        policy:
          circuit_breaker_max_failures: 10
          max_retries: 3
          request_timeout: "30s"
        upstream_addr: "127.0.0.1:8080"
    kind: ConfigMap
    metadata:
      labels:
        app: openclaw-mesh-lareira-mesh-spec
        app.kubernetes.io/instance: openclaw-mesh
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: lareira-mesh-spec
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: lareira-mesh-spec-0.3.1
        mesh.pleme.io/spec: openclaw-mesh
      name: openclaw-mesh-aresta-config
      namespace: openclaw
