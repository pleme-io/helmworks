golden — default values render the full openclaw mesh:
  1: |
    apiVersion: spire.spiffe.io/v1alpha1
    kind: ClusterSPIFFEID
    metadata:
      labels:
        app: openclaw-mesh-lareira-mesh-spec
        app.kubernetes.io/instance: openclaw-mesh
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: lareira-mesh-spec
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.3.0
        helm.sh/chart: lareira-mesh-spec-0.3.1
        mesh.pleme.io/spec: openclaw-mesh
      name: openclaw-mesh-cartorio
    spec:
      className: spire-system-spire
      namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: openclaw
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: openclaw-stack
          app.kubernetes.io/name: cartorio
      spiffeIDTemplate: spiffe://{{ .TrustDomain }}/ns/{{ .PodMeta.Namespace }}/sa/{{ .PodSpec.ServiceAccountName }}
