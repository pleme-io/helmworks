  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app: respiro-lareira-respiro
        app.kubernetes.io/component: respiro-consumer
        app.kubernetes.io/instance: respiro
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: lareira-respiro
        app.kubernetes.io/part-of: nexus-platform
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: lareira-respiro-0.1.0
