    spec:
      replicas: 0
      selector:
        matchLabels:
          app.kubernetes.io/component: respiro-consumer
          app.kubernetes.io/instance: respiro
          app.kubernetes.io/name: lareira-respiro
      template:
        metadata:
          labels:
            app: respiro-lareira-respiro-consumer
            app.kubernetes.io/component: respiro-consumer
            app.kubernetes.io/instance: respiro
            app.kubernetes.io/name: lareira-respiro
        spec:
          containers:
            - env:
                - name: NATS_URL
                  value: nats://pleme-nats.nats.svc:4222
                - name: RESPIRO_STREAM
                  value: AUDIT
