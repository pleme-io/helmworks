          "name": "AUDIT",
          "subjects": ["audit.\u003e"],
          "retention": "workqueue",
          "storage": "file",
          "num_replicas": 1,
          "max_consumers": -1,
          "max_msgs": -1,
          "max_msgs_per_subject": -1,
